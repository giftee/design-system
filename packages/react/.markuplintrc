{
  "specs": {
    "\\.[jt]sx?$": "@markuplint/react-spec"
  },
  "parser": {
    "\\.[jt]sx?$": "@markuplint/jsx-parser"
  },
  "extends": [
    "markuplint:recommended"
  ],
  "rules": {
    "label-has-control": false
  },
  "overrides": {
    "./src/components/linkText/Index.tsx": {
      "rules": {
        "wai-aria": {
          "options": {
            "checkingDeprecatedProps": false
          }
        }
      }
    }
  }
}
